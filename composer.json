{
    "name": "dartmoon/prestashop-module",
    "description": "A module skeleton for PrestaShop 9.2 and later",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Dartmoon",
            "homepage": "https://dartmoon.io"
        }
    ],
    "require": {
        "php": "^8.1",
        "dartmoon/prestashop-module-toolkit": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Dartmoon\\ExampleModule\\": "app/"
        }
    },
    "scripts": {
        "post-create-project-cmd": [
            "@php bin/module setup",
            "@composer update --lock --no-scripts --no-interaction",
            "@tools:install"
        ],
        "setup": "@php bin/module setup",
        "tools:install": "@composer install --working-dir=tools --no-interaction",
        "doctor": "@php bin/module doctor",
        "build": "@php bin/module build",
        "build-module": "@build",
        "test": "@php tools/tests/run.php"
    },
    "extra": {
        "prestashop-module": {
            "name": "examplemodule",
            "namespace": "Dartmoon\\ExampleModule"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.1.0"
        },
        "allow-plugins": false
    }
}
