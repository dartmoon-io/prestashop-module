{
    "name": "dartmoon/prestashop-module-tools",
    "description": "Private development tools shipped with the module skeleton",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-zip": "*",
        "friendsofphp/php-cs-fixer": "^3.0",
        "humbug/php-scoper": "^0.18.20",
        "nikic/php-parser": "^5.0",
        "prestashop/php-dev-tools": "^5.0",
        "symfony/filesystem": "^6.4",
        "symfony/finder": "^6.4",
        "symfony/process": "^6.4"
    },
    "autoload": {"psr-4": {"Dartmoon\\ModuleTools\\": "src/"}},
    "config": {"sort-packages": true, "platform": {"php": "8.2.0"}, "allow-plugins": false}
}
